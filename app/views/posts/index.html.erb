<tr>
<th class = "">予定一覧</th>

<th class = ""><%= link_to "新規登録", new_post_path %></th>
</tr>

<table class = "card p-3 md-3 ">
  
  <tr class = "table-light">
    <th >ID</th>
    <th >タイトル</th>
    <th >開始日</th>
    <th >終了日</th>
    <th >終日</th>
    <th >更新日</th>
  </tr>
  <% @posts.each do |post| %>
    <tr class = "list">
      <td ><%= post.id %></td>
      <td ><%= post.title %></td>
      <td ><%= post.start_date %></td>
      <td ><%= post.end_date %></td>
      <td ><%= post.all_day ? "〇" : "　"%></td>
      <td ><%= post.updated_at.strftime("%Y-%m-%d") %>
      <%= post.updated_at.strftime("%H:%M") %></td>
      <td><%= link_to "詳細", post %></td>
      <td><%= link_to "編集", edit_post_path(post) %></td>
      
      <td><%= button_to '削除', post_path(post), 
            method: :delete, 
            form: {
            data: {   controller: "turbo-confirm", 
                            action: "submit->turbo-confirm#confirm",
                            turbo_confirm: "予定を削除しますか？" 
                            }
                          }, 
                          class: "btn btn-light" %>
      </td>
    </tr>
    
   
  <% end %>
</table>
<td>登録件数<%= @posts.count %>件</td>
        <td><%= Time.current.strftime("%Y-%m-%d") %></td>
