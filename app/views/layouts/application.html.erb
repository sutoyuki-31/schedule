<!DOCTYPE html>
<html>
  <head>
<link href="https://jsdelivr.net" rel="stylesheet">

    <link href="https://jsdelivr.net" rel="">
    <title><%= content_for(:title) || "Schedule App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

  
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body date-turbo="false">
    
    <header class = "card" >
    <h3 class = "header text-center">スケジュール管理アプリ</h3>
    
  </header>
    <% flash.each do |key, message| %>

      <div class="alert <%= key =='notice' ? 'alert-success' :'alert-danger' %> m-3" role = "alert"><%= message %></div>
    <% end %>

    <%= yield %>
    <div id="turbo-confirm-model-container"></div>
  </body>
</html>
